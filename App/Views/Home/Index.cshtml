@{
    var actorName = Context.Session.GetString("FullName") ?? Context.Session.GetString("EMP_CODE") ?? "";
}
@{
    ViewData["Title"] = " ระบบตรวจสอบใบคำขอ SG Finance+ ";
}

@using (Html.BeginForm("Search", "Home", FormMethod.Post, new { id = "searchForm" }))
{
    <div class="filter-card mb-3">
        <div class="filter-card-head">
            <span class="filter-card-title">ค้นหาใบคำขอ</span>
            <span class="filter-card-hint">ไม่ระบุวันที่ = ค้นหาเฉพาะวันนี้ · ระบุเลขที่ใบคำขอ/สัญญา/Serial/เลขบัตร = ค้นหาได้ทุกช่วงเวลา</span>
        </div>

        <div class="filter-grid">
            <div>
                <label class="form-label" for="ApplicationCode">เลขที่ใบคำขอ</label>
                <input type="text" id="ApplicationCode" name="ApplicationCode" class="form-control" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" for="AccountNo">เลขที่สัญญา</label>
                <input type="text" id="AccountNo" name="AccountNo" class="form-control" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" for="ProductSerialNo">Serial / IMEI</label>
                <input type="text" id="ProductSerialNo" name="ProductSerialNo" class="form-control" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" for="CustomerName">ชื่อลูกค้า</label>
                <input type="text" id="CustomerName" name="CustomerName" class="form-control" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" for="CustomerID">เลขบัตรประชาชน</label>
                <input type="text" id="CustomerID" name="CustomerID" class="form-control" autocomplete="off" />
            </div>

            <div>
                <label class="form-label" for="status">สถานะ</label>
                @* เดิมมีให้เลือกแค่ 3 สถานะ ใบที่อยู่สถานะอื่นจึงกรองหาไม่ได้เลย
                   ต้องรู้เลขที่ใบคำขอมาก่อนถึงจะหาเจอ

                   ไม่ใส่ NEW เพราะใบที่สถานะ NEW ยังไม่มีข้อมูลใน ApplicationExtend สักใบ
                   ผลค้นหาจึงเป็นศูนย์เสมอ ใส่ไว้จะทำให้เข้าใจผิดว่าไม่มีใบคำขอในสถานะนั้น *@
                <select class="form-select" name="status" id="status">
                    <option value="">ทั้งหมด</option>
                    <optgroup label="ปิดงานแล้ว">
                        <option value="CLOSED">CLOSED — ปิดงาน</option>
                        <option value="CANCELLED">CANCELLED — ยกเลิก</option>
                        <option value="REJECTED">REJECTED — ปฏิเสธ</option>
                    </optgroup>
                    <optgroup label="ระหว่างดำเนินการ">
                        <option value="CLOSING">CLOSING — กำลังปิดงาน</option>
                        <option value="DRAFT">DRAFT — ร่าง</option>
                        <option value="SUBMITTED">SUBMITTED — ส่งพิจารณา</option>
                        <option value="REVIEWING">REVIEWING — กำลังพิจารณา</option>
                        <option value="NCB">NCB — ตรวจ NCB</option>
                        <option value="NEEDMOREINFO">NEEDMOREINFO — ขอเอกสารเพิ่ม</option>
                        <option value="REVISING">REVISING — ส่งกลับให้แก้ไข</option>
                        <option value="PENDING">PENDING — รอดำเนินการ</option>
                    </optgroup>
                </select>
            </div>
            <div>
                <label class="form-label" for="StatusRegis">สถานะลงทะเบียน</label>
                <select class="form-select" name="StatusRegis" id="StatusRegis">
                    <option value="">ทั้งหมด</option>
                    <option value="0">รอลงทะเบียน</option>
                    <option value="1">ลงทะเบียนเรียบร้อย</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="loanTypeCate">ประเภทรายการ</label>
                <select class="form-select" name="loanTypeCate" id="loanTypeCate">
                    <option value="">ทั้งหมด</option>
                    <option value="LOCKPHONE" selected>LOCKPHONE</option>
                    <option value="HP">HP</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="startdate">วันที่เริ่มต้น</label>
                <input type="text" id="startdate" name="startdate" class="date form-control" autocomplete="off" placeholder="ปปปป/ดด/วว" />
            </div>
            <div>
                <label class="form-label" for="enddate">วันที่สิ้นสุด</label>
                <input type="text" id="enddate" name="enddate" class="date form-control" autocomplete="off" placeholder="ปปปป/ดด/วว" />
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary" id="BtnsearchResults">
                <i class="fa-solid fa-magnifying-glass"></i> ค้นหา
            </button>
            <button type="button" class="btn btn-outline-secondary" id="BtnClearFilters">ล้างเงื่อนไข</button>
        </div>
    </div>
}

<div class="results-wrap" data-actor="@actorName">
    <div class="loaddong">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลด</span>
        </div>
    </div>

    <div id="searchAlert"></div>

    <div id="searchToolbar" class="results-toolbar" hidden>
        <div class="results-count" id="resultsCount"></div>
        <div class="results-tools">
            @* ค้นในผลลัพธ์ — ไล่หาทุกคอลัมน์ที่แสดงบนตาราง รวมสาขา พนักงานขาย ชื่อสินค้า
               ซึ่งช่องกรองด้านบนไม่มีให้ · ค้นที่ server จึงครอบคลุมทุกหน้า ไม่ใช่เฉพาะหน้าที่เห็น *@
            <div class="quick-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" id="quickSearch" class="form-control form-control-sm"
                       placeholder="ค้นในผลลัพธ์ เช่น ชื่อสาขา พนักงานขาย ชื่อสินค้า" autocomplete="off" />
            </div>
            <label class="mb-0 text-nowrap" for="pageSizeSelect">แสดงหน้าละ</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:auto"></select>
            <button type="button" id="btnRefreshNow" class="btn btn-outline-primary btn-sm text-nowrap" title="อ่านข้อมูลสดจากฐานข้อมูลทันที">
                <i class="fa-solid fa-rotate"></i> รีเฟรช
            </button>
            <div class="form-check form-switch mb-0 text-nowrap">
                <input class="form-check-input" type="checkbox" id="autoRefresh">
                <label class="form-check-label" for="autoRefresh">อัปเดตอัตโนมัติ</label>
            </div>
            <button type="button" id="btnExportSearch" class="btn btn-success btn-sm text-nowrap">
                <i class="fa-solid fa-file-excel"></i> ดาวน์โหลดทั้งหมด
            </button>
            <a href="/Home/Stats" class="btn btn-outline-secondary btn-sm text-nowrap"
               title="ดูว่าการค้นหาใช้เวลาเท่าไร และช้าตรงไหน">
                <i class="fa-solid fa-gauge-high"></i> สถิติ
            </a>
        </div>
    </div>

    <div id="searchTableWrap" class="table-responsive" hidden>
        <table id="example" class="display dataTable table-secondary" style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th class="sortable" data-sort="date">วันที่สร้างใบคำขอ</th>
                    <th class="sortable" data-sort="account">เอกสาร</th>
                    <th class="sortable" data-sort="branch">สาขา</th>
                    <th class="sortable" data-sort="product">ชื่อสินค้าและหมายเลขสินค้า</th>
                    <th class="sortable" data-sort="status">สถานะ</th>
                    @* สถานะสัญญา / ตรวจสอบ เรียงไม่ได้ เพราะดึงมาทีหลังเฉพาะแถวของหน้านั้น *@
                    <th>สถานะสัญญา</th>
                    <th>ตรวจสอบ</th>
                </tr>
            </thead>
            <tbody id="searchTableBody"></tbody>
        </table>
    </div>

    <nav id="searchPager" aria-label="แบ่งหน้า" hidden></nav>
</div>
